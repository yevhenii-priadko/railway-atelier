# Copy to .env.local for local development. In production (Render), set
# these as environment variables on the web service instead of a file.

# MongoDB connection string (MongoDB Atlas free tier works fine).
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Optional — defaults to "railway_atelier" if not set.
MONGODB_DB=railway_atelier

# The one shared password for /admin. Anton (or anyone with this password)
# can add/edit/delete works in the archive. Pick something long and random
# — it's compared in plain text on the server, never sent anywhere else.
ADMIN_PASSWORD=

# Random secret used to sign the /admin login cookie. Any long random
# string works — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=

# Used to build the sitemap/robots.txt with real URLs instead of a
# placeholder. Set to the site's real production domain.
NEXT_PUBLIC_SITE_URL=https://example.com
